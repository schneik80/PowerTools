cache/

# Machine-local user preferences store. Auto-created on first run from
# registry-derived defaults (settings_store.py); the palette init.js files
# above are regenerated whenever a palette opens. Both are per-machine state, not
# shipped config.
settings/preferences.json
.cursor/rules/

# Agent guidance is tracked on purpose: AGENTS.md (entry point), CLAUDE.md,
# .agent/ (tool-neutral: environment, symptom index, workflow),
# .claude/settings.json (shared permission allowlist), .claude/rules/ and
# .claude/skills/. Do NOT add any of those here -- the learnings are meant to
# travel with the repo. Only the per-machine permission overrides stay local.
# None of it ships: the release build strips .agent/, .claude/, CLAUDE.md and
# AGENTS.md (tools/release/build_release.py EXCLUDED_DIRS / EXCLUDED_FILES).
.claude/settings.local.json

# Developer-only DEBUG marker: create an empty `.debug` file in the add-in root
# to enable verbose logging (config.DEBUG). Never committed.
.debug
